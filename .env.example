# Optionnel : sans fichier .env, les valeurs par defaut ci-dessous sont utilisees.
# Pour les modifier :  cp .env.example .env

DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=bookstore_db

# Mot de passe du certificat HTTPS auto-signe genere au demarrage (6 caracteres minimum)
SSL_KEYSTORE_PASSWORD=bookstore-dev
